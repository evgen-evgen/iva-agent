{
  "_comment": "Production CEO memory profile. Keep this contract aligned with evals/ceo-memory/v1/schema-ceo-extension.json.",
  "node_types": {
    "project": {
      "description": "Ongoing project or initiative with deliverables",
      "required": ["description", "tags", "status"],
      "status": ["blocked"]
    },
    "meeting": {
      "description": "A scheduled or completed business conversation with participants, outcomes, and source context",
      "required": ["description", "tags", "status"],
      "status": ["scheduled", "completed", "cancelled", "superseded"]
    },
    "commitment": {
      "description": "An explicit promise or obligation with a stable identity, owner, deliverable, due time, provenance, and deterministic lifecycle",
      "required": [
        "description",
        "tags",
        "status",
        "commitment_id",
        "owner",
        "deliverable",
        "due_at",
        "completed_at",
        "source",
        "source_role",
        "last_source",
        "last_source_role"
      ],
      "status": ["open", "done", "cancelled"]
    }
  },
  "card_type_dirs": {
    "meeting": "meetings",
    "commitment": "commitments"
  },
  "domain_inference": {
    "cards/meetings/": "work",
    "cards/commitments/": "work"
  },
  "path_type_hints": {
    "cards/meetings/": "meeting",
    "cards/commitments/": "commitment"
  },
  "status_order": {
    "open": 0,
    "blocked": 1,
    "scheduled": 1,
    "completed": 7,
    "done": 7,
    "cancelled": 11,
    "superseded": 9
  }
}
