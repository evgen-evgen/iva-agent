# Copy these settings to data/custom/plugins/iva-mail.env on the Iva server.
# Never commit the real password.
MAIL_IMAP_HOST=mail.example.com
MAIL_IMAP_PORT=993
MAIL_IMAP_TLS=true
MAIL_IMAP_STARTTLS=false

MAIL_SMTP_HOST=mail.example.com
MAIL_SMTP_PORT=465
MAIL_SMTP_TLS=true
MAIL_SMTP_STARTTLS=false
MAIL_SMTP_AUTH=login

MAIL_USERNAME=iva@example.com
MAIL_PASSWORD=replace-on-server
MAIL_FROM=Iva <iva@example.com>

# Keep sending disabled until mail_check_connection succeeds.
MAIL_ALLOW_SEND=false

# Optional: exact IMAP folder name returned by mail_list_mailboxes.
# MAIL_SENT_MAILBOX=Sent

MAIL_TIMEOUT_SECONDS=30
